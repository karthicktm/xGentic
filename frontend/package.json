    "@typescript-eslint/eslint-plugin": "^8.22.0",
    "@typescript-eslint/parser": "^8.22.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.0",
    "happy-dom": "^16.7.2",
    "postcss": "^8.4.49",
    "prettier": "^3.7.1",
    "prettier-plugin-tailwindcss": "^0.6.14",
